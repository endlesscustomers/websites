{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/cards/**",
              "components/chrome/**",
              "components/comparison/**",
              "components/content/**",
              "components/core/**",
              "components/diagrams/annotated/**",
              "components/diagrams/bar-chart/**",
              "components/diagrams/brand/**",
              "components/diagrams/flow/**",
              "components/diagrams/frame/**",
              "components/pricing/**",
              "components/proof/**",
              "components/sections/cta-band/**",
              "components/sections/feature-grid/**",
              "components/sections/hero/**",
              "components/sections/peeking-video/**",
              "components/sections/qualifier-band/**",
              "components/sections/quote-band/**",
              "components/sections/split-feature/**",
              "components/sections/step-band/**",
              "components/sections/team-grid/**",
              "components/sections/testimonial-wall/**",
              "components/sections/video-feature/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Proxima Nova|Proxima Nova Condensed|Merriweather|Kalam))/i]",
        "message": "Font not provided by the design system. Available: Proxima Nova, Proxima Nova Condensed, Merriweather, Kalam."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnnotatedVisual'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|ratio|annotations|accent|key|ref|className|style|children)$/]",
        "message": "<AnnotatedVisual> doesn't accept that prop. Declared props: src, alt, ratio, annotations, accent."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, variant."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:green|blue|dark|outline|solid)$/]",
        "message": "<Badge> variant must be one of 'green' | 'blue' | 'dark' | 'outline' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BarChartDiagram'] > JSXAttribute > JSXIdentifier[name!=/^(?:data|height|showValues|unit|key|ref|className|style|children)$/]",
        "message": "<BarChartDiagram> doesn't accept that prop. Declared props: data, height, showValues, unit."
      },
      {
        "selector": "JSXOpeningElement[name.name='BlogCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|title|date|author|href|key|ref|className|style|children)$/]",
        "message": "<BlogCard> doesn't accept that prop. Declared props: image, title, date, author, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandDiagram'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|caption|maxWidth|key|ref|className|style|children)$/]",
        "message": "<BrandDiagram> doesn't accept that prop. Declared props: src, alt, caption, maxWidth."
