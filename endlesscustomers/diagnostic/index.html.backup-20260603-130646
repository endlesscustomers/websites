  ];

  function runSteps() {
    const bar       = document.getElementById('progBar');
    const stepsList = document.getElementById('stepsList');
    const STEP_H    = 42; // px per row

    STEPS.forEach((s, i) => {
      setTimeout(() => {
        const el  = document.getElementById(s.id);
        const ico = el.querySelector('.proc-step-ico');
        const sts = document.getElementById(s.id + '-status');
        el.classList.add('active');
        ico.innerHTML = '<span class="ico-spin"></span>';
        sts.textContent = 'Running...';
        bar.style.width = s.pct + '%';
        // Slide list so active step is always the 3rd visible row
        const offset = Math.max(0, (i - 2) * STEP_H);
        stepsList.style.transform = 'translateY(-' + offset + 'px)';
        // Show top fade only once items have scrolled out of view
        if (offset > 0) stepsList.parentElement.classList.add('is-scrolled');
