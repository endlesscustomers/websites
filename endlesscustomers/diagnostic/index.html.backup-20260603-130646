  /* ─── Shuffle helper ─── */
  function shuffled(arr) {
    const a = [...arr];
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  /* ─── Headline rotator ─── */
  let headlineTimers = [];

  function startHeadlines() {
    const el    = document.getElementById('procHeadline');
    const pool  = shuffled(HEADLINES);
    let   index = 0;

    // Set the first headline immediately (no animation on first show)
    el.textContent = pool[index];

    function rotateNext() {
      index = (index + 1) % pool.length;
      const next = pool[index];

      // Fade out
      el.classList.add('fade-out');
      const t1 = setTimeout(() => {
        el.textContent = next;
        el.classList.remove('fade-out');
        el.classList.add('fade-in');
        requestAnimationFrame(() => requestAnimationFrame(() => {
          el.classList.remove('fade-in');
        }));
      }, 450);
      headlineTimers.push(t1);
    }

    // Rotate every 8 seconds (fits 4 headlines in 32s)
    const interval = setInterval(rotateNext, 8000);
    headlineTimers.push(interval);
  }

  function stopHeadlines() {
    headlineTimers.forEach(t => { clearInterval(t); clearTimeout(t); });
    headlineTimers = [];
  }

  /* ─── Step runner (37 seconds total, 17 steps) ─── */
  const STEPS = [
