<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Endless Customers — Instant Diagnostic</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link href="https://api.fontshare.com/v2/css?f[]=general-sans@400,500,600,700,800&display=swap" rel="stylesheet">
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --ec-magenta:  #E33EA8;
    --ec-blue:     #1C78FF;
    --ec-green:    #45BF4A;
    --ec-gradient: linear-gradient(135deg, #E33EA8 0%, #1C78FF 50%, #45BF4A 100%);
    --ec-bg:       #F5F5F7;
    --ec-surface:  #FFFFFF;
    --ec-text:     #1D1D1F;
    --ec-text-2:   #555558;
    --ec-border:   #D2D2D7;
  }

  html, body {
    height: 100%;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
    background: var(--ec-bg);
    color: var(--ec-text);
    line-height: 1.6;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }

  /* Open Sans for all headings */
  h1, h2, h3, h4, h5, h6 {
    font-family: 'General Sans', sans-serif;
  }

  /* ─── PAGE SYSTEM ─── */
  .page {
    position: fixed;
    inset: 0;
    overflow-y: auto;
    transition: opacity 0.35s ease, transform 0.35s ease;
  }
  .page.hidden {
    opacity: 0;
    pointer-events: none;
    transform: translateY(24px);
  }

  /* ─── LANDING NAV ─── */
  .lp-nav {
    background: #FFFFFF;
    border-bottom: 1px solid #E5E5EA;
    padding: 14px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .lp-logo { display: flex; align-items: center; gap: 10px; text-decoration: none; }
  .lp-logo-mark {
    width: 34px; height: 34px;
    border-radius: 9px;
    background: var(--ec-gradient);
    display: flex; align-items: center; justify-content: center;
    color: #fff; font-size: 13px; font-weight: 900;
    letter-spacing: -0.5px; flex-shrink: 0;
  }
  .lp-logo-text {
    font-size: 15px; font-weight: 800;
    background: var(--ec-gradient);
    -webkit-background-clip: text; background-clip: text;
    color: transparent; -webkit-text-fill-color: transparent;
    letter-spacing: -0.02em;
  }

  /* ─── LANDING HERO ─── */
  #page-landing { background: #FFFFFF; min-height: 100vh; }

  .lp-hero { background: #FFFFFF; padding: 80px 24px 56px; text-align: center; }

  /* Apple-style pre-header — no pill, pure type */
  .lp-preheader {
    display: block;
    font-family: 'General Sans', sans-serif;
    font-size: 15px;
    font-weight: 600;
    color: #555558;
    letter-spacing: 0.01em;
    margin-bottom: 16px;
  }

  @keyframes lp-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: 0.5; transform: scale(0.85); }
  }

  .lp-h1 {
    font-family: 'General Sans', sans-serif;
    font-size: clamp(36px, 5.5vw, 64px);
    font-weight: 800; color: #1D1D1F;
    line-height: 1.1; max-width: 780px;
    margin: 0 auto 22px; letter-spacing: -0.02em;
  }
  .lp-sub {
    font-size: 18px; color: #555558;
    max-width: 560px; margin: 0 auto 40px; line-height: 1.7;
  }

  /* Search input */
  .lp-search-wrap {
    display: flex; align-items: center;
    background: #FFFFFF; border: 1.5px solid #D2D2D7;
    border-radius: 9999px; padding: 7px 7px 7px 24px;
    max-width: 660px; width: 100%; margin: 0 auto;
    box-shadow: 0 4px 28px rgba(0,0,0,0.09);
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .lp-search-wrap:focus-within {
    border-color: var(--ec-blue);
    box-shadow: 0 4px 32px rgba(28,120,255,0.13);
  }
  .lp-url-input {
    flex: 1; border: none; outline: none;
    font-size: 16px; background: transparent; color: #1D1D1F;
    font-family: 'Inter', sans-serif; min-width: 0; padding: 4px 0;
  }
  .lp-url-input::placeholder { color: #A1A1A6; }

  .lp-go-btn {
    position: relative; isolation: isolate;
    background: #1D1D1F; color: #fff;
    border: none; border-radius: 9999px;
    padding: 14px 24px; font-size: 14px; font-weight: 700;
    cursor: pointer; white-space: nowrap;
    font-family: 'Inter', sans-serif; letter-spacing: -0.01em;
    transition: transform 200ms ease; flex-shrink: 0;
  }
  .lp-go-btn:hover { transform: scale(1.02); }
  .lp-go-btn::before {
    content: ''; position: absolute; inset: -3px; border-radius: 9999px;
    padding: 2px; background: var(--ec-gradient);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor; mask-composite: exclude;
    opacity: 0; transition: opacity 200ms ease;
    pointer-events: none; z-index: -1;
  }
  .lp-go-btn:hover::before { opacity: 1; }

  .lp-trust {
    display: flex; align-items: center; justify-content: center;
    gap: 10px; margin-top: 18px;
    font-size: 13px; color: #A1A1A6; flex-wrap: wrap;
  }
  .lp-trust-dot { color: #D2D2D7; }

  /* Mockup preview */
  .lp-mockup-section {
    background: linear-gradient(to bottom, #FFFFFF 0%, #F5F5F7 100%);
    padding: 0 24px 64px; display: flex; justify-content: center;
  }
  .lp-mockup-card {
    background: #FFFFFF; border: 1px solid #E5E5EA;
    border-radius: 16px; box-shadow: 0 20px 64px rgba(0,0,0,0.11);
    max-width: 700px; width: 100%; overflow: hidden;
  }
  .mock-header {
    background: #F5F5F7; border-bottom: 1px solid #E5E5EA;
    padding: 12px 20px; display: flex;
    align-items: center; justify-content: space-between;
  }
  .mock-dots { display: flex; gap: 6px; align-items: center; }
  .mock-dot { width: 10px; height: 10px; border-radius: 50%; }
  .mock-title-bar { font-size: 12px; font-weight: 600; color: #A1A1A6; }
  .mock-body { padding: 22px 28px 28px; }
  .mock-company { font-size: 11px; font-weight: 700; color: #A1A1A6; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px; }
  .mock-headline { font-size: 17px; font-weight: 800; color: #1D1D1F; margin-bottom: 18px; letter-spacing: -0.01em; }
  .mock-scores { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .mock-score {
    display: flex; align-items: center; justify-content: space-between;
    background: #F5F5F7; border-radius: 8px; padding: 10px 14px; font-size: 12px;
  }
  .mock-score-label { color: #555558; font-weight: 500; }
  .mock-score-grade {
    font-weight: 800; font-size: 14px;
    width: 28px; height: 28px; border-radius: 7px;
    display: flex; align-items: center; justify-content: center;
  }
  .g-b { background: rgba(20,184,166,0.12); color: #14B8A6; }
  .g-c { background: rgba(245,158,11,0.12); color: #D97706; }
  .g-d { background: rgba(249,115,22,0.12); color: #F97316; }
  .g-f { background: rgba(239,68,68,0.12);  color: #EF4444; }

  /* Features */
  .lp-features { background: #F5F5F7; padding: 80px 24px; }
  .lp-features-inner { max-width: 980px; margin: 0 auto; }
  .lp-sec-title {
    font-size: 30px; font-weight: 800; color: #1D1D1F;
    text-align: center; margin-bottom: 48px; letter-spacing: -0.02em;
  }
  .lp-features-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 24px; }
  @media (max-width: 720px) { .lp-features-grid { grid-template-columns: 1fr; } }
  .lp-feature { background: #FFFFFF; border: 1px solid #E5E5EA; border-radius: 16px; padding: 28px 24px; }
  .lp-feat-icon {
    width: 48px; height: 48px; border-radius: 13px;
    background: var(--ec-gradient);
    display: flex; align-items: center; justify-content: center;
    font-size: 22px; margin-bottom: 16px;
  }
  .lp-feat-title { font-size: 16px; font-weight: 800; color: #1D1D1F; margin-bottom: 10px; letter-spacing: -0.01em; }
  .lp-feat-desc { font-size: 14px; color: #555558; line-height: 1.75; }

  /* FAQ */
  .lp-faq { background: #FFFFFF; padding: 80px 24px 96px; }
  .lp-faq-inner { max-width: 720px; margin: 0 auto; }
  .lp-faq-title { font-size: 30px; font-weight: 800; color: #1D1D1F; margin-bottom: 40px; letter-spacing: -0.02em; }
  .faq-item { border-bottom: 1px solid #E5E5EA; }
  .faq-q {
    width: 100%; background: none; border: none;
    padding: 20px 0; font-size: 15px; font-weight: 700; color: #1D1D1F;
    text-align: left; cursor: pointer;
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    font-family: 'Inter', sans-serif; transition: color 0.2s;
  }
  .faq-q:hover { color: var(--ec-blue); }
  .faq-icon {
    width: 24px; height: 24px; border-radius: 50%; background: #F5F5F7;
    display: flex; align-items: center; justify-content: center;
    font-size: 18px; line-height: 1; flex-shrink: 0; color: #555558;
    transition: all 0.2s;
  }
  .faq-item.open .faq-icon { background: var(--ec-blue); color: #fff; transform: rotate(45deg); }
  .faq-a { display: none; padding: 0 40px 20px 0; font-size: 14px; color: #555558; line-height: 1.8; }
  .faq-item.open .faq-a { display: block; }

  /* ─── PROCESSING PAGE ─── */
  #page-next {
    background: #FFFFFF;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    min-height: 100vh; padding: 60px 24px 80px;
    text-align: center;
  }

  /* Apple-style processing pre-header */
  .proc-preheader {
    display: block;
    font-family: 'General Sans', sans-serif;
    font-size: 15px;
    font-weight: 600;
    color: #555558;
    letter-spacing: 0.01em;
    margin-bottom: 16px;
  }

  /* Rotating headline — fixed height so steps never shift */
  .proc-headline-wrap {
    height: 180px; /* tall enough for any 3-line headline at max size */
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 40px;
    overflow: hidden;
  }
  .proc-headline {
    font-family: 'General Sans', sans-serif;
    font-size: clamp(30px, 4.5vw, 44px);
    font-weight: 800; color: #1D1D1F;
    line-height: 1.18; max-width: 640px;
    letter-spacing: -0.02em;
    transition: opacity 0.45s ease, transform 0.45s ease;
  }
  .proc-headline.fade-out { opacity: 0; transform: translateY(-8px); }
  .proc-headline.fade-in  { opacity: 0; transform: translateY(10px); }

  /* Domain pill */
  .proc-domain-pill {
    display: inline-flex; align-items: center; gap: 7px;
    background: rgba(28,120,255,0.07);
    border: 1px solid rgba(28,120,255,0.18);
    color: var(--ec-blue); font-size: 13px; font-weight: 600;
    padding: 7px 16px; border-radius: 9999px;
    margin-bottom: 40px;
  }

  /* Progress bar */
  .proc-prog-outer {
    width: 100%; max-width: 480px;
    height: 4px; background: #E5E5EA;
    border-radius: 100px; overflow: hidden;
    margin-bottom: 36px;
  }
  .proc-prog-bar {
    height: 100%; width: 0%;
    background: var(--ec-gradient);
    border-radius: 100px;
    transition: width 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Step list — sliding window */
  .proc-steps-wrap {
    position: relative;
    width: 100%; max-width: 480px;
    height: 210px; /* shows exactly 5 steps */
    overflow: hidden;
  }
  /* Fade top and bottom edges */
  .proc-steps-wrap::before,
  .proc-steps-wrap::after {
    content: '';
    position: absolute;
    left: 0; right: 0;
    height: 44px;
    z-index: 2;
    pointer-events: none;
  }
  .proc-steps-wrap::before {
    top: 0;
    background: linear-gradient(to bottom, #ffffff 30%, transparent);
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .proc-steps-wrap.is-scrolled::before {
    opacity: 1;
  }
  .proc-steps-wrap::after {
    bottom: 0;
    background: linear-gradient(to top, #ffffff 30%, transparent);
  }
  .proc-steps {
    width: 100%;
    display: flex; flex-direction: column;
    text-align: left;
    transition: transform 0.55s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .proc-step {
    display: flex; align-items: center; gap: 12px;
    padding: 9px 4px;
    border-bottom: 1px solid #F0F0F2;
    transition: opacity 0.3s;
  }
  .proc-step:last-child { border-bottom: none; }

  .proc-step-ico {
    width: 22px; height: 22px;
    display: flex; align-items: center; justify-content: center;
    font-size: 15px; flex-shrink: 0;
    transition: color 0.3s;
    color: #A1A1A6;
  }
  .proc-step.done .proc-step-ico { color: var(--ec-green); font-size: 14px; }

  .proc-step-label {
    font-size: 14px; font-weight: 400; color: #A1A1A6; flex: 1;
    transition: color 0.3s, font-weight 0.3s;
  }
  .proc-step.active .proc-step-label { color: #1D1D1F; font-weight: 500; }
  .proc-step.done  .proc-step-label  { color: #555558; font-weight: 400; }

  .proc-step-status {
    font-size: 12px; font-weight: 500; color: transparent; flex-shrink: 0;
    transition: color 0.3s;
    min-width: 56px; text-align: right;
  }
  .proc-step.active .proc-step-status { color: var(--ec-blue); }
  .proc-step.done  .proc-step-status  { color: #A1A1A6; }

  @keyframes spin { to { transform: rotate(360deg); } }
  .spin { display: inline-block; animation: spin 0.9s linear infinite; }

  /* ─── Step icon states ─── */
  .ico-dot {
    display: block;
    width: 8px; height: 8px;
    border-radius: 50%;
    background: #D2D2D7;
  }
  .ico-spin {
    display: block;
    width: 14px; height: 14px;
    border-radius: 50%;
    border: 2px solid #E5E5EA;
    border-top-color: var(--ec-blue);
    animation: spin 0.8s linear infinite;
  }

  /* ─── RESULTS PAGE ─── */
  #page-results {
    background: #FFFFFF;
  }

  .res-layout {
    min-height: 100vh;
  }

  /* Sidebar */
  .res-sidebar {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow-y: auto;
    background: #FFFFFF;
    border-right: 1px solid #E5E5EA;
    padding: 36px 28px 40px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .res-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    margin-bottom: 40px;
  }
  .res-logo-mark {
    width: 30px; height: 30px;
    border-radius: 8px;
    background: var(--ec-gradient);
    display: flex; align-items: center; justify-content: center;
    color: #fff; font-size: 12px; font-weight: 900;
    letter-spacing: -0.5px; flex-shrink: 0;
  }
  .res-logo-text {
    font-size: 13px; font-weight: 800;
    background: var(--ec-gradient);
    -webkit-background-clip: text; background-clip: text;
    color: transparent; -webkit-text-fill-color: transparent;
    letter-spacing: -0.02em;
  }

  /* Overall grade arc (SVG-based) */
  .res-score-wrap {
    position: relative;
    width: 140px; height: 140px;
    margin: 0 auto 16px;
    align-self: center;
    flex-shrink: 0;
  }
  .res-score-svg {
    width: 140px; height: 140px;
  }
  .res-score-center {
    position: absolute;
    inset: 0;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    gap: 2px;
  }
  .res-score-letter {
    font-family: 'General Sans', sans-serif;
    font-size: 42px; font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .res-score-sub {
    font-size: 10px; font-weight: 600;
    color: #A1A1A6;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  /* Grade letter colors */
  .grade-color-a { color: #45BF4A; }
  .grade-color-b { color: #14B8A6; }
  .grade-color-c { color: #F59E0B; }
  .grade-color-d { color: #F97316; }
  .grade-color-f { color: #EF4444; }

  .res-sidebar-domain {
    font-size: 13px; font-weight: 600;
    color: #888890;
    align-self: center;
    margin-bottom: 28px;
  }

  .res-sidebar-headline {
    font-family: 'General Sans', sans-serif;
    font-size: 22px; font-weight: 800;
    color: #1D1D1F;
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin-bottom: 10px;
  }

  .res-sidebar-sub {
    font-size: 16px;
    font-weight: 400;
    color: #555558;
    line-height: 24px;
    margin-bottom: 28px;
  }

  .res-email-input {
    width: 100%;
    background: #FFFFFF;
    border: 1.5px solid #D2D2D7;
    border-radius: 10px;
    padding: 12px 16px;
    font-size: 15px;
    color: #1D1D1F;
    font-family: 'Inter', sans-serif;
    outline: none;
    margin-bottom: 10px;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .res-email-input::placeholder { color: #A1A1A6; }
  .res-email-input:focus {
    border-color: var(--ec-blue);
    box-shadow: 0 0 0 3px rgba(28,120,255,0.1);
  }

  .res-cta-btn {
    width: 100%;
    background: var(--ec-gradient);
    color: #FFFFFF;
    border: none;
    border-radius: 10px;
    padding: 14px 20px;
    font-size: 15px; font-weight: 700;
    font-family: 'Inter', sans-serif;
    cursor: pointer;
    letter-spacing: -0.01em;
    transition: opacity 0.2s, transform 0.2s;
  }
  .res-cta-btn:hover { opacity: 0.9; transform: scale(1.02); }

  .res-sidebar-fine {
    font-size: 11px;
    color: #A1A1A6;
    margin-top: 10px;
    line-height: 1.5;
    align-self: center;
    text-align: center;
  }

  /* Right content area */
  .res-content {
    padding: 0 52px 280px;
  }

  /* ─── Right frame top nav ─── */
  .res-content-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 0;
    border-bottom: 1px solid #E5E5EA;
    margin-bottom: 0;
  }
  .res-content-logo {
    display: flex; align-items: center; gap: 8px; text-decoration: none;
  }
  .res-content-logo-mark {
    width: 30px; height: 30px; border-radius: 8px;
    background: var(--ec-gradient);
    display: flex; align-items: center; justify-content: center;
    color: #fff; font-size: 12px; font-weight: 900;
    letter-spacing: -0.5px; flex-shrink: 0;
  }
  .res-content-logo-text {
    font-size: 13px; font-weight: 800;
    background: var(--ec-gradient);
    -webkit-background-clip: text; background-clip: text;
    color: transparent; -webkit-text-fill-color: transparent;
    letter-spacing: -0.02em;
  }
  .res-nav-talk-btn {
    background: #FFFFFF;
    border: 1.5px solid #D2D2D7;
    border-radius: 9999px;
    padding: 10px 22px;
    font-size: 14px; font-weight: 700;
    color: #1D1D1F;
    font-family: 'Inter', sans-serif;
    cursor: pointer;
    letter-spacing: -0.01em;
    transition: border-color 0.2s, color 0.2s;
  }
  .res-nav-talk-btn:hover { border-color: var(--ec-blue); color: var(--ec-blue); }

  /* Hero sub-copy */
  .res-hero-sub {
    font-size: 17px;
    color: #555558;
    line-height: 1.7;
    text-align: center;
    max-width: 580px;
    margin: 0 auto 36px;
  }

  /* Hero email CTA */
  .res-hero-cta-wrap {
    display: flex; align-items: center;
    background: #FFFFFF;
    border: 1.5px solid #D2D2D7;
    border-radius: 9999px;
    padding: 7px 7px 7px 24px;
    max-width: 540px; width: 100%;
    margin: 0 auto 12px;
    box-shadow: 0 4px 28px rgba(0,0,0,0.07);
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .res-hero-cta-wrap:focus-within {
    border-color: var(--ec-blue);
    box-shadow: 0 4px 32px rgba(28,120,255,0.13);
  }
  .res-hero-email-input {
    flex: 1; border: none; outline: none;
    font-size: 15px; background: transparent; color: #1D1D1F;
    font-family: 'Inter', sans-serif; min-width: 0; padding: 4px 0;
  }
  .res-hero-email-input::placeholder { color: #A1A1A6; }
  .res-hero-cta-btn {
    background: #1D1D1F; color: #fff;
    border: none; border-radius: 9999px;
    padding: 13px 22px; font-size: 14px; font-weight: 700;
    cursor: pointer; white-space: nowrap;
    font-family: 'Inter', sans-serif; letter-spacing: -0.01em;
    transition: transform 200ms ease; flex-shrink: 0;
  }
  .res-hero-cta-btn:hover { transform: scale(1.02); }

  .res-grade-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 52px auto 0;
  }
  .res-grade-domain {
    font-size: 14px; font-weight: 600;
    color: #888890;
    margin-top: 8px;
  }

